# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Optional for local demo mode - local store automatically activated if not set)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Engine (OpenAI / Groq)
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# Twilio Telephony Webhook Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+918045678901

# LiveKit (Optional for WebRTC Audio Pipeline)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
DEEPGRAM_API_KEY=your-deepgram-api-key
CARTESIA_API_KEY=your-cartesia-api-key
